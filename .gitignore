# Virtual environment (~5 GB, rebuildable with venv + pip)
.venv/

# Python bytecode
__pycache__/
*.pyc

# Short clips cut out of the match videos on every run by
# zoneout.video.create_video_chunk - overwritten each reception, never input.
temporary_videos/

# Pipeline output. Per-reception and per-attack folders hold annotated
# detection videos (~40 MB each), interactive trajectory pages (~4.9 MB each,
# embedding plotly) and plots - several GB per match, all regenerable by
# re-running the pipelines, so none of it is stored.
reception_data/
reception_figures/
attack_data/

# Output of detection_test.py, the standalone detection sandbox: the trimmed
# input clip and the annotated copy, both regenerable by re-running it.
detection_test_output/

# Serve figures generated by datasets/serve_figures.py - regenerable from the
# dataset, and each folder carries its own 4.9 MB copy of plotly.min.js.
datasets/serve_figures/
